# MySQL connection (TCP). Prefer a dedicated user; root with empty password fails over TCP.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=UnTrade
# Optional: use a Unix socket instead of TCP (leave empty for TCP)
# DB_UNIX_SOCKET=/var/run/mysqld/mysqld.sock

# API
API_HOST=127.0.0.1
API_PORT=8001

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
